-- Mensagem rápida
local function showMsg(txt)
    local msg = Instance.new("TextLabel")
    msg.Size = UDim2.new(0.6,0,0,28)
    msg.Position = UDim2.new(0.2,0,0.88,0)
    msg.BackgroundTransparency = 0.35
    msg.BackgroundColor3 = Color3.fromRGB(40,40,25)
    msg.Text = txt
    msg.Font = Enum.Font.GothamBold
    msg.TextColor3 = Color3.fromRGB(255,233,90)
    msg.TextScaled = true
    msg.AnchorPoint = Vector2.new(0,0)
    msg.ZIndex = 99
    local c = Instance.new("UICorner", msg)
    c.CornerRadius = UDim.new(0, 10)
    msg.Parent = screenGui
    TweenService:Create(msg, TweenInfo.new(0.16), {BackgroundTransparency=0.19, TextTransparency=0}):Play()
    task.wait(0.7)
    TweenService:Create(msg, TweenInfo.new(0.3), {BackgroundTransparency=1, TextTransparency=1}):Play()
    task.wait(0.3)
    msg:Destroy()
end

-- Efeitos de chão ainda mais realista
local function setFloorReflectance(val)
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and part.Anchored and part.Size.X > 8 and part.Size.Z > 8 and math.abs(part.Position.Y) < 1000 then
            part.Reflectance = val
            part.Material = val > 0 and Enum.Material.Mirror or Enum.Material.Concrete
        end
    end
end

-- Flare do Sol
local sunObj
local function setSun(enable)
    if enable then
        if not sunObj then
            sunObj = Instance.new("Part")
            sunObj.Size = Vector3.new(1,1,1)
            sunObj.Anchored = true
            sunObj.CanCollide = false
            sunObj.Transparency = 1
            sunObj.Name = "RealisticSunFlare"
            sunObj.Parent = workspace

            local sunLight = Instance.new("PointLight", sunObj)
            sunLight.Color = Color3.fromRGB(255, 235, 130)
            sunLight.Brightness = 60 -- Muito mais intenso
            sunLight.Range = 1200
            sunLight.Shadows = true

            local sunFlare = Instance.new("BillboardGui", sunObj)
            sunFlare.Size = UDim2.new(0, 170, 0, 170)
            sunFlare.AlwaysOnTop = true
            local img = Instance.new("ImageLabel", sunFlare)
            img.BackgroundTransparency = 1
            img.Size = UDim2.new(1,0,1,0)
            img.Image = "rbxassetid://14668741420"
            img.ImageColor3 = Color3.fromRGB(255,235,130)
            img.ImageTransparency = 0.14
        end
        sunObj.Position = Vector3.new(0, 600, -300)
    else
        if sunObj then sunObj:Destroy() sunObj = nil end
    end
end

