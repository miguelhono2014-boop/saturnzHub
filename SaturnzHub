-- Ativar/desativar geral
local ativo = false
local function updateButtonState()
    if ativo then
        button.BackgroundColor3 = Color3.fromRGB(65, 180, 90)
        button.Text = "Ativado"
    else
        button.BackgroundColor3 = Color3.fromRGB(200, 80, 80)
        button.Text = "Desativado"
    end
end

local function toggle()
    ativo = not ativo
    setLighting(ativo)
    setFloorReflectance(ativo and 0.78 or 0)
    setSun(ativo)
    updateButtonState()
    showMsg(ativo and "Pôr-do-sol ativado" or "Pôr-do-sol desativado")
end

button.MouseButton1Click:Connect(toggle)
close.MouseButton1Click:Connect(function() screenGui:Destroy() end)

-- Arrastar compatível com mobile (Touch e Mouse)
local dragging = false
local dragStart, startPos

local function updateInput(input)
    local delta = input.Position - dragStart
    frame.Position = UDim2.new(
        startPos.X.Scale, math.clamp(startPos.X.Offset + delta.X, 0, workspace.CurrentCamera.ViewportSize.X-140),
        startPos.Y.Scale, math.clamp(startPos.Y.Offset + delta.Y, 0, workspace.CurrentCamera.ViewportSize.Y-40)
    )
end

frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

frame.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        updateInput(input)
    end
end)

-- Inicializa desativado e botão vermelho
setLighting(false)
setFloorReflectance(0)
setSun(false)
updateButtonState()
